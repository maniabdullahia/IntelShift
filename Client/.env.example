# Client (Vite/React) config. Copy to `Client/.env` and fill in.
# Vite only exposes vars prefixed with VITE_. These ship to the browser —
# use PUBLIC tokens only (e.g. Paddle CLIENT token live_/test_, NOT the server key).

VITE_API_BASE_URL=
VITE_SOCKET_URL=

# Auth0 (public)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=

# Paddle (client-side)
VITE_PADDLE_CLIENT_TOKEN=   # live_… or test_… (never pdl_… server key)
VITE_PADDLE_ENV=sandbox      # sandbox | production
