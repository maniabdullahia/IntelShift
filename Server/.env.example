# Server (Node/Express) config. Copy to `Server/.env` and fill in.
# NEVER commit the real .env. Rotate any key that was ever committed.

# ── Runtime ──
NODE_ENV=development
PORT=

# ── Databases / infra ──
MONGO_URI=                 # use a TEST database for tests/seeders, never prod
# Absolute URL INCLUDING the /api prefix (the client calls /v1/... paths).
PYTHON_SERVER_URL=http://127.0.0.1:8000/api
# Shared secret for the Python API. Put the SAME value in the Python service's
# COMPINTEL_SERVICE_KEYS. Leave empty only in local dev.
PYTHON_API_KEY=
PYTHON_API_TIMEOUT_MS=300000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Security / ops ──
TRUST_PROXY=1               # behind nginx: so rate limits see the real client IP
LOG_REQUEST_BODIES=0        # 1 = log REDACTED request bodies (local debugging only)
ENABLE_DEBUG_ROUTES=0       # 1 = enable admin-only /api/debug-fetch
ALLOW_PRIVATE_URLS=0        # 1 = allow crawling localhost/private IPs (local dev only)
CRAWL_RATE_LIMIT_PER_MIN=60   # url-tree, detect-stores, validate-url, collection-count (per user)
HEAVY_RATE_LIMIT_PER_MIN=20   # validate-site, suggest-competitors (per user)
MATCH_RATE_LIMIT_PER_MIN=60   # product-matches (per user)
AUTH_RATE_LIMIT_PER_MIN=10    # login / register / password reset (per IP)
BUSINESS_TYPE_ALLOWLIST=       # e.g. "gymshark,khaadi" — release stores wrongly routed to Enterprise
AI_MATCH_MAX_PAIRS=12         # collection pairs AI-matched per competitor per analysis
STALE_SCAN_MINUTES=180      # a scan stuck "Processing" longer than this is reset

# ── URLs / CORS ──
BASE_URL=
CLIENT_URL=
CORS_ORIGIN=
CORS_METHODS=
CORS_CREDENTIALS=

# ── Auth (JWT) ──
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRATION=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRATION=
BCRYPT_SALT_ROUNDS=

# ── Auth0 ──
AUTH0_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_SECRET=

# ── AI providers ──
AI_PROVIDER=openai         # openai | claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Competitor search ──
SEARCH_PROVIDER=searxng
SEARXNG_URL=
BRAVE_API_KEY=

# ── Billing: Paddle (server API key = pdl_live_/pdl_sdbx_, NOT the client token) ──
PADDLE_API_KEY=
PADDLE_BASE_URL=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_PRO=

# ── Billing: Stripe (if used) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_ENDPOINT=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_DOMAIN=
EMAIL_LOGO_URL=
