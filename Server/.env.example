# Server (Node/Express) config. Copy to `Server/.env` and fill in.
# NEVER commit the real .env. Rotate any key that was ever committed.

# ── Runtime ──
NODE_ENV=development
PORT=

# ── Databases / infra ──
MONGO_URI=                 # use a TEST database for tests/seeders, never prod
PYTHON_SERVER_URL=http://127.0.0.1:8000
# Redis is read from Server/app/config/redis.js (127.0.0.1:6379)

# ── URLs / CORS ──
BASE_URL=
CLIENT_URL=
CORS_ORIGIN=
CORS_METHODS=
CORS_CREDENTIALS=

# ── Auth (JWT) ──
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRATION=
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRATION=
BCRYPT_SALT_ROUNDS=

# ── Auth0 ──
AUTH0_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_SECRET=

# ── AI providers ──
AI_PROVIDER=openai         # openai | claude
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Competitor search ──
SEARCH_PROVIDER=searxng
SEARXNG_URL=
BRAVE_API_KEY=

# ── Billing: Paddle (server API key = pdl_live_/pdl_sdbx_, NOT the client token) ──
PADDLE_API_KEY=
PADDLE_BASE_URL=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_GROWTH=
PADDLE_PRICE_PRO=

# ── Billing: Stripe (if used) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_ENDPOINT=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_DOMAIN=
EMAIL_LOGO_URL=
