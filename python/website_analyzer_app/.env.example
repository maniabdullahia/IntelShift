# Python analyzers config. Copy to `python/website_analyzer_app/.env` and fill in.
# Loaded by website_analyzer_app/main.py.

AI_PROVIDER=openai                 # openai | claude
OPENAI_API_KEY=
OPENAI_MINI_MODEL=gpt-4o-mini      # avoid gpt-5-* unless your OpenAI org is verified
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional fallback fetcher
FIRECRAWL_API_KEY=
