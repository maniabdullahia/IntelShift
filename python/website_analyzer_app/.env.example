# Python analyzers config. Copy to `python/website_analyzer_app/.env` and fill in.
# Loaded by website_analyzer_app/main.py.

AI_PROVIDER=openai                 # openai | claude
OPENAI_API_KEY=
OPENAI_MINI_MODEL=gpt-4o-mini      # avoid gpt-5-* unless your OpenAI org is verified
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional fallback fetcher
FIRECRAWL_API_KEY=

# ── API security (python/api_security.py) ──
# Same value as Server PYTHON_API_KEY. Service keys authenticate the Node backend
# and skip rate limiting. Leave empty only in local dev (auth disabled).
COMPINTEL_SERVICE_KEYS=
COMPINTEL_API_KEY=
RATE_LIMIT_PER_MINUTE=60
HEAVY_RATE_LIMIT_PER_MINUTE=30

# ── Crawler safety / capacity (level1_detector/net_guard.py) ──
MAX_BROWSERS=3              # concurrent Chromium instances (~200MB each)
BROWSER_SLOT_WAIT_S=300     # how long a fetch waits for a free browser
ALLOW_PRIVATE_URLS=0        # 1 = allow localhost/private IPs (local dev only)
